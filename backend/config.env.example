# Скопировать в config.env (chmod 600), заполнить. Переменные окружения имеют приоритет.

# ── Админка /upload ──
ADMIN_USER=admin
# python3 admin_tools.py password
ADMIN_PASS_HASH=
# python3 admin_tools.py totp  (пусто = вход без второго фактора; на проде обязательно заполнить)
ADMIN_TOTP_SECRET=

# ── Сеть ──
# 1 — бэкенд стоит за nginx и IP клиента берётся из X-Forwarded-For; 0 — слушает напрямую
TRUST_PROXY=1
# auto — Secure-cookie при https; на локалке через http ставить 0
COOKIE_SECURE=auto
# папка со статикой сайта (куда пишется prices.json); по умолчанию ../site
#SITE_DIR=/srv/metek/site

# ── Почта для заявок ──
# Сейчас: Яндекс 360 для бизнеса. При переезде на рег.ру меняются только SMTP_HOST и SMTP_PASS
# (см. deploy/DEPLOY.md, раздел «Миграция почты»).
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
# ОТ ИМЕНИ кого уходят письма. SMTP_PASS — не пароль ящика, а «пароль приложения»:
# Яндекс ID → Безопасность → Пароли приложений → «Почта» (в ящике должен быть включён IMAP/SMTP:
# Настройки почты → Все настройки → Почтовые программы → «С сервера imap.yandex.ru по протоколу IMAP»)
SMTP_USER=info@meteksochi.ru
SMTP_PASS=
MAIL_FROM=info@meteksochi.ru
MAIL_FROM_NAME=Сайт МЕТЭК Сочи
# КОМУ приходят заявки (через запятую можно несколько)
MAIL_TO=info@meteksochi.ru

# ── Sprint 1: PostgreSQL (создать роль и базу отдельно, не хранить реальный пароль в Git) ──
# Пример для локального PostgreSQL 16:
DATABASE_URL=postgresql+psycopg://metek:CHANGE_ME@127.0.0.1:5432/metek_sprint1
